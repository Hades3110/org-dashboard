# Copy to .env (git-ignored) and fill in to enable AI-powered structured
# search. Without a key, natural-language search still works fully — it
# falls back to plain-text matching (see docs/adr/0003-ai-search-fallback.md).

ANTHROPIC_API_KEY=
AI_SEARCH_MODEL=claude-3-5-haiku-20241022
AI_SEARCH_TIMEOUT_MS=8000

# Port docker-compose publishes the app on (the nginx/client container).
CLIENT_PORT=8080
